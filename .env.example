# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Public: inlined into the client bundle at build time. Not secrets. ---
NEXT_PUBLIC_GTM=GTM-XXXXXXX
NEXT_PUBLIC_APP_URL=https://sounakdas.in
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Server-only: must NOT carry the NEXT_PUBLIC_ prefix. ---
# Zoho app-specific password used by app/api/contact to send mail.
ZOHO_MAIL_ADDRESS=you@example.com
ZOHO_MAIL_PASSKEY=

# reCAPTCHA server-side verification key, used by app/api/google.
RECAPTCHA_SECRET_KEY=
